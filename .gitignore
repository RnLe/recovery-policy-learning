# local research notes, never published
private_docs/

# generated experiment artifacts, at the repository root only: a nested
# directory called data or build is source, not an artifact
/data/
/runs/
/results/
/tmp/
/build/

# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# website: dependencies, builds, and staged evidence (regenerated by
# `grf stage-site`); hand-drawn illustrations stay tracked
node_modules/
site/dist/
site/public/data/
site/public/figures/
site/public/media/
site/public/reports/
site/public/staging-manifest.json
